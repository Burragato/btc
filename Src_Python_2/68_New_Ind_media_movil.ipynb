   "source": [
    "\n",
    "def media_movil(df, variable, num_periodos = 24): \n",
    "   mm = pd.DataFrame()\n",
    "     for cada in range(2, num_periodos+1):\n",
    "           mm[variable + '_mm_' + str(cada)] = df[variable].shift(1).rolling(cada).mean()\n",
    "           \n",
    "\n",
    "     return(mm)\n"
   ]
  }
